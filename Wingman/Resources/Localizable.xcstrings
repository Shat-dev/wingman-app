          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce qui t’en empêche d’habitude ?"
          }
        }
      }
    },
    "What would feeling sure of yourself change this week?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was würde sich diese Woche ändern, wenn du dir deiner selbst sicher wärst?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué cambiaría esta semana si te sintieras seguro de ti mismo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce que ça changerait cette semaine de te sentir sûr de toi ?"
          }
        }
      }
    },
    "What would your first conversation back out there sound like?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie würde sich dein erstes Gespräch nach der Pause anhören?"
          }
        },
        "es" : {
          "stringUnit" : {
