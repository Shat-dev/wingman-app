    },
    "Keeping a conversation going past small talk without any romantic incentive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Gespräch über den Smalltalk hinaus führen, ganz ohne romantische Absicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantener una conversación más allá de la charla casual sin ningún interés romántico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faire durer une conversation au-delà des banalités, sans visée romantique."
