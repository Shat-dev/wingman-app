    "Go to your home screen, then open Wingman again." : {
      "comment" : "Alert message after picking another app language. The new language applies from the next launch; Wingman quits on its own once the user leaves it, so reopening from the home screen is enough. Shown in the newly picked language.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wechsle zum Home-Bildschirm und öffne Wingman dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ve a tu pantalla de inicio y vuelve a abrir Wingman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Va sur ton écran d’accueil, puis rouvre Wingman."
