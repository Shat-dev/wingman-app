        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quelle est la seule chose qui t’empêche de dire bonjour ?"
          }
        }
      }
    },
    "What’s the worst a polite “no” could actually cost you?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was würde dich ein höfliches „Nein“ wirklich kosten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué te costaría de verdad un “no” amable?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Que te coûterait vraiment un « non » poli ?"
          }
        }
      }
    },
    "When did a conversation last feel like more than small talk?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wann hat sich ein Gespräch zuletzt nach mehr als Smalltalk angefühlt?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Cuándo fue la última vez que una conversación fue más allá de lo casual?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À quand remonte une conversation qui allait au-delà des banalités ?"
          }
        }
      }
    },
    "When did you last meet someone without a screen in between?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wann hast du zuletzt jemanden ohne Bildschirm dazwischen kennengelernt?"
