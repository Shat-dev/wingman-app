        }
      }
    },
    "They're on this device only. An account keeps them if you change phones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie sind nur auf diesem Gerät gespeichert. Mit einem Konto bleiben sie erhalten, wenn du das Handy wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
