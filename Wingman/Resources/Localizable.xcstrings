    },
    "Things Wingman users have said" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das sagen Wingman-Nutzer"
          }
        }
      }
    },
    "This deletes your logged approaches and all progress on this device. There's no account to recover them from. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit werden deine erfassten Ansprachen und dein gesamter Fortschritt auf diesem Gerät gelöscht. Es gibt kein Konto, aus dem sie wiederhergestellt werden könnten. Das kann nicht rückgängig gemacht werden."
          }
        }
      }
    },
    "This plan isn't available on your App Store account right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Abo ist für deinen App-Store-Account gerade nicht verfügbar."
          }
        }
      }
    },
    "This purchase needs approval before it can go through — usually from the account holder or your bank. You'll get access automatically once it's approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Kauf muss erst genehmigt werden – meist vom Kontoinhaber oder deiner Bank. Sobald er genehmigt ist, bekommst du automatisch Zugriff."
