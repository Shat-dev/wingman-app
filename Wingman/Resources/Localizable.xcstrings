          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada de frases cursis. Solo cosas prácticas y tranquilas para estar presente. Mi ansiedad social se redujo a la mitad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas de phrases de drague ringardes. Juste des conseils posés et concrets pour être dans l’instant. Mon anxiété sociale a été divisée par deux."
