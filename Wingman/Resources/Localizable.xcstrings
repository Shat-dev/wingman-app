        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À quoi ressemblerait ta première conversation pour te relancer ?"
          }
        }
      }
    },
    "What’s one question you could ask that isn’t small talk?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Welche Frage könntest du stellen, die kein Smalltalk ist?"
