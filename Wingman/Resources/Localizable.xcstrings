      }
    },
    "Greet neighbors with small talk" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit Nachbarn ein bisschen Smalltalk halten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saludar a tus vecinos con una charla casual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saluer ses voisins et échanger quelques mots"
          }
        }
      }
    },
    "Half of men don't approach. Most who do, succeed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Hälfte der Männer spricht niemanden an. Die meisten, die es tun, haben Erfolg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La mitad de los hombres no se acerca. La mayoría de los que lo hacen, lo logra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La moitié des hommes n’abordent pas. La plupart de ceux qui le font réussissent."
          }
        }
      }
    },
    "Her" : {
      "comment" : "Speaker label in a scenario when the woman's name is unknown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
