    },
    "Home" : {
      "comment" : "Tab bar title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start"
          }
        },
        "es" : {
          "stringUnit" : {
