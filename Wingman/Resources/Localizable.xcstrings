    "Welcome Back" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Willkommen zurück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bienvenido de nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Content de te revoir"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "おかえりなさい"
          }
        }
      }
    },
    "Welcome to Wingman. This is home.\nDaily practice keeps you sharp. The log fills with moments you took, not replayed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Willkommen bei Wingman. Hier bist du zu Hause.\nDie tägliche Übung hält dich in Form. Dein Logbuch füllt sich mit Momenten, die du genutzt hast – nicht mit solchen, die du im Kopf durchspielst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bienvenido a Wingman. Esta es tu pantalla principal.\nLa práctica diaria te mantiene en forma. Tu registro se va llenando con los momentos que aprovechaste, no con los que te quedaste repasando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bienvenue sur Wingman. Voici ton accueil.\nL’entraînement du jour te garde en forme. Ton journal se remplit des moments que tu as saisis, pas de ceux que tu as ressassés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wingmanへようこそ。ここがホームです。\n今日の練習で感覚を保ちましょう。記録には、頭の中で繰り返した場面ではなく、実際に動いた瞬間がたまっていきます。"
          }
        }
      }
    },
    "What are you mainly hoping to improve?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was möchtest du vor allem verbessern?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué es lo que más quieres mejorar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce que tu veux surtout améliorer ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一番伸ばしたいのはどれですか？"
          }
        }
      }
    },
    "What brought you to Wingman?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was hat dich zu Wingman gebracht?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué te trajo a Wingman?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce qui t’amène sur Wingman ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wingmanを始めたきっかけは何ですか？"
          }
        }
      }
    },
    "What happens in the second before you freeze?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was passiert in der Sekunde, bevor du erstarrst?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué pasa en el segundo antes de bloquearte?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Que se passe-t-il dans la seconde où tu te figes ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "固まってしまう直前の1秒、何が起きていますか？"
          }
        }
      }
    },
    "What if a little nervousness just reads as genuine?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was, wenn ein bisschen Nervosität einfach echt wirkt?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Y si un poco de nervios solo se nota como algo genuino?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et si un peu de nervosité paraissait simplement sincère ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "少しの緊張は、誠実さとして伝わるだけだとしたら？"
          }
        }
      }
    },
    "What if your opener didn’t need to be clever?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was, wenn dein Opener gar nicht clever sein muss?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Y si tu frase de apertura no tuviera que ser ingeniosa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Et si ta phrase d’accroche n’avait pas besoin d’être brillante ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最初のひと言は、気の利いたものでなくていいとしたら？"
          }
        }
      }
    },
    "What type of Interaction ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Welche Art von Begegnung?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué tipo de interacción?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quel type d’interaction ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "どんなやり取りでしたか？"
          }
        }
      }
    },
    "What usually stops you from doing so?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was hält dich normalerweise davon ab?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué es lo que normalmente te frena?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce qui te retient, en général ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "いつも何がブレーキになっていますか？"
          }
        }
      }
    },
    "What would feeling sure of yourself change this week?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was würde sich diese Woche ändern, wenn du dir deiner selbst sicher wärst?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué cambiaría esta semana si te sintieras seguro de ti mismo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu’est-ce que ça changerait cette semaine de te sentir sûr de toi ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分に自信が持てたら、今週は何が変わりますか？"
          }
        }
      }
    },
    "What would your first conversation back out there sound like?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie würde sich dein erstes Gespräch nach der Pause anhören?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Cómo sonaría tu primera conversación al volver a intentarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À quoi ressemblerait ta première conversation pour te relancer ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "久しぶりに踏み出す最初の会話は、どんなものになりそうですか？"
          }
        }
      }
    },
    "What’s one question you could ask that isn’t small talk?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Welche Frage könntest du stellen, die kein Smalltalk ist?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué pregunta podrías hacer que no sea de charla casual?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quelle question pourrais-tu poser qui ne soit pas une banalité ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "雑談で終わらない質問をひとつ挙げるなら？"
          }
        }
      }
    },
    "What’s the one thing that stops you from saying hi?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was ist das eine, das dich davon abhält, Hallo zu sagen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué es lo único que te impide saludar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quelle est la seule chose qui t’empêche de dire bonjour ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「こんにちは」のひと言を止めているものは何ですか？"
          }
        }
      }
    },
    "What’s the worst a polite “no” could actually cost you?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was würde dich ein höfliches „Nein“ wirklich kosten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué te costaría de verdad un “no” amable?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
