    "They're just waiting for you to make the first move" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie warten nur darauf, dass du den ersten Schritt machst"
          }
        }
      }
    },
    "They're on this device only. An account keeps them if you change phones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
