    "By continuing you agree to our" : {
      "comment" : "Start of the sign-in legal line in the English layout only. Translated apps show the whole sentence \"By continuing you agree to our [Terms](terms) and [Privacy](privacy)\" instead, so this piece is never translated.",
      "shouldTranslate" : false
    },
    "By continuing you agree to our [Terms](terms) and [Privacy](privacy)" : {
      "comment" : "Sign-in legal line, one whole sentence with two links. Translate the words in [square brackets] and move the links wherever the sentence needs them. Keep (terms) and (privacy) exactly as they are.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indem du fortfährst, stimmst du unseren [AGB](terms) und der [Datenschutzerklärung](privacy) zu"
          }
        }
      }
    },
