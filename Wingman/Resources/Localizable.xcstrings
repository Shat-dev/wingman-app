    "That account is already linked to another Wingman login. Log in with it instead — progress from this session won't carry over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Konto ist bereits mit einem anderen Wingman-Login verknüpft. Melde dich stattdessen damit an – der Fortschritt aus dieser Sitzung wird nicht übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esa cuenta ya está vinculada a otro inicio de sesión de Wingman. Inicia sesión con ella; el progreso de esta sesión no se transferirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce compte est déjà lié à une autre connexion Wingman. Connecte-toi plutôt avec celle-ci : la progression de cette session ne sera pas transférée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "そのアカウントは、すでに別のWingmanログインに連携されています。そちらでログインしてください。今回のセッションの進捗は引き継がれません。"
          }
        }
      }
    },
    "That one's further down the line. Start with the first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der kommt erst später dran. Fang mit dem ersten an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ese viene más adelante. Empieza por el primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Celui-là vient plus tard. Commence par le premier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "それはもう少し先です。まずは最初のものから始めましょう。"
          }
        }
      }
    },
    "That payment method was declined. Check your payment details in the App Store and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Zahlungsmethode wurde abgelehnt. Prüf deine Zahlungsdaten im App Store und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se rechazó ese método de pago. Revisa tus datos de pago en el App Store e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce moyen de paiement a été refusé. Vérifie tes informations de paiement dans l’App Store et réessaie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
