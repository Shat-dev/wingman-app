    },
    "This deletes your logged approaches and all progress on this device. There's no account to recover them from. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit werden deine erfassten Ansprachen und dein gesamter Fortschritt auf diesem Gerät gelöscht. Es gibt kein Konto, aus dem sie wiederhergestellt werden könnten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto elimina tus acercamientos registrados y todo tu progreso en este dispositivo. No hay ninguna cuenta para recuperarlos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette action supprime tes approches notées et toute ta progression sur cet appareil. Aucun compte ne permet de les récupérer. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この端末に記録したアプローチと、すべての進捗が削除されます。復元できるアカウントはありません。この操作は取り消せません。"
          }
        }
      }
    },
    "This plan isn't available on your App Store account right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Abo ist für deinen App-Store-Account gerade nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
