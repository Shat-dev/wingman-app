          }
        }
      }
    },
    "To achieve what I want, I must grow. I won’t let fear make the decision for me. I’ll take my chance, and learn from what happens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um zu erreichen, was ich will, muss ich wachsen. Ich lasse nicht die Angst für mich entscheiden. Ich nutze meine Chance und lerne aus dem, was passiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para conseguir lo que quiero, tengo que crecer. No voy a dejar que el miedo decida por mí. Me voy a lanzar y voy a aprender de lo que pase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour obtenir ce que je veux, je dois évoluer. Je ne laisserai pas la peur décider à ma place. Je vais tenter ma chance et apprendre de ce qui se passera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "望むものを手に入れるには、成長しなければなりません。恐れに決断を任せません。チャンスをつかみ、起きたことから学びます。"
          }
        }
      }
