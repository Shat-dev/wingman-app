          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cursos: mentalidad, cómo acercarte, coqueteo y qué hacer después.\nLecciones cortas para ser el hombre que se lanza, no el que se queda paralizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les cours : état d’esprit, aborder, flirter, et l’après.\nDes leçons courtes pour devenir l’homme qui y va, pas celui qui bloque."
          }
