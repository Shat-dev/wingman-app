    },
    "Keep holding until the ring fills." : {
      "comment" : "Commitment pact screen, under the logo, after the user let go before the press-and-hold finished. The ring is the circle around the logo that fills while holding.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte weiter gedrückt, bis der Kreis voll ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén presionado hasta que se llene el círculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reste appuyé jusqu’à ce que le cercle soit plein."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リングがいっぱいになるまで、押し続けてください。"
          }
        }
      }
    },
    "Keep it flowing, no awkward silences" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein peinliches Schweigen mehr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sin silencios incómodos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des échanges fluides, sans blancs"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "気まずい沈黙なしで会話が続く"
          }
        }
      }
    },
    "Keeping a conversation going past small talk without any romantic incentive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Gespräch über den Smalltalk hinaus führen, ganz ohne romantische Absicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantener una conversación más allá de la charla casual sin ningún interés romántico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faire durer une conversation au-delà des banalités, sans visée romantique."
