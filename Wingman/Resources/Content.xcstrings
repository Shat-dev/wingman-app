    "Any change, even a change for the better, is always accompanied by drawbacks and discomforts." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Veränderung, selbst eine zum Besseren, bringt Nachteile und Unbehagen mit sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todo cambio, incluso un cambio para bien, siempre trae inconvenientes e incomodidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout changement, même pour le mieux, s’accompagne toujours d’inconvénients et d’inconfort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "どんな変化にも、たとえ良い変化であっても、不便と居心地の悪さがついてくる。"
          }
        }
      }
    },
    "Any problem is a chance for you to do your best." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes Problem ist eine Chance, dein Bestes zu geben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada problema es una oportunidad para dar lo mejor de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque problème est une occasion de donner le meilleur de toi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "どんな問題も、ベストを尽くすチャンスだ。"
          }
        }
      }
    },
    "Anything that happens beats nothing happening at all." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles, was passiert, ist besser, als wenn gar nichts passiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cualquier cosa que pase es mejor que no pase nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout ce qui arrive vaut mieux que rien du tout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "何も起きないより、何かが起きるほうがずっといい。"
          }
        }
      }
    },
