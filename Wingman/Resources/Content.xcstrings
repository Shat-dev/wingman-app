          }
        }
      }
    },
    "Courage is being scared to death, but moving forward anyway." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mut heißt, Todesangst zu haben und trotzdem weiterzugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El valor es estar muerto de miedo y avanzar de todos modos."
          }
        }
      }
    },
    "Courage is the birthplace of confidence." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mut ist der Ursprung von Selbstvertrauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El valor es la cuna de la seguridad."
          }
        }
      }
    },
    "Creating Opportunities" : {
      "comment" : "Course title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
