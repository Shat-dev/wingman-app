        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cansado de estar solo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envie de ne plus être seul"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ひとりでいるのに疲れた"
          }
        }
      }
    },
    "Trust yourself. You are capable of much more than you think." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertrau dir selbst. Du kannst viel mehr, als du denkst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Confía en ti. Eres capaz de mucho más de lo que crees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fais-toi confiance. Tu es capable de bien plus que tu ne le penses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分を信じよう。思っているより、ずっと多くのことができる。"
          }
        }
      }
    },
    "Upgrading Your Lifestyle" : {
      "comment" : "Course title.",
      "extractionState" : "manual",
      "localizations" : {
