    "Life is not about living the safer option. Life is about living a life worth living." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Im Leben geht es nicht um die sichere Option. Es geht darum, ein Leben zu führen, das sich lohnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vida no se trata de elegir la opción más segura. Se trata de vivir una vida que valga la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vie, ce n’est pas choisir l’option la plus sûre. C’est vivre une vie qui en vaut la peine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人生とは、安全な道を選ぶことではない。生きる価値のある人生を生きることだ。"
          }
        }
      }
    },
    "Life shrinks or expands in proportion to one's courage." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Leben schrumpft oder wächst im Verhältnis zum eigenen Mut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vida se encoge o se expande en proporción al valor de cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vie se rétrécit ou s’épanouit en proportion du courage de chacun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人生は、勇気に比例して縮みもすれば、広がりもする。"
