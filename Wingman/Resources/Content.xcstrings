        }
      }
    },
    "Our greatest glory is not in never falling, but in rising every time we fall." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unser größter Ruhm liegt nicht darin, nie zu fallen, sondern jedes Mal wieder aufzustehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuestra mayor gloria no está en no caer nunca, sino en levantarnos cada vez que caemos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Notre plus grande gloire n’est pas de ne jamais tomber, mais de nous relever à chaque chute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最大の栄光は、一度も転ばないことではなく、転ぶたびに起き上がることにある。"
          }
        }
      }
    },
    "Patience, persistence and perspiration make an unbeatable combination for success." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geduld, Ausdauer und Schweiß sind eine unschlagbare Kombination für Erfolg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paciencia, perseverancia y sudor forman una combinación imbatible para el éxito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Patience, persévérance et transpiration forment une combinaison imbattable pour réussir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "忍耐、粘り強さ、そして汗。この3つが揃えば、成功は揺るがない。"
          }
        }
      }
    },
