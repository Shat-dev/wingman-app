      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Komfortzonen sind stille Orte, an denen sich nichts ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las zonas de confort son lugares tranquilos donde nada cambia."
