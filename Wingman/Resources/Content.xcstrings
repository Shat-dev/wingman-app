    "Small deeds done are better than great deeds planned." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleine Taten, die man ausführt, sind besser als große, die man plant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Más valen pequeñas acciones hechas que grandes acciones planeadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mieux valent de petites actions accomplies que de grandes actions planifiées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "計画しただけの偉業より、やり遂げた小さな行いのほうがいい。"
          }
        }
      }
    },
