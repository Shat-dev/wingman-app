          "stringUnit" : {
            "state" : "needs_review",
            "value" : "欲しかったものはすべて、恐怖の向こう側にある。"
          }
        }
      }
    },
    "Failure and rejection are the first steps to succeeding." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
