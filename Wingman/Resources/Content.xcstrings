    "Recognizing that you are not where you want to be is a starting point to begin changing your life." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zu erkennen, dass du noch nicht da bist, wo du sein willst, ist der Ausgangspunkt, um dein Leben zu verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reconocer que no estás donde quieres estar es el punto de partida para empezar a cambiar tu vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reconnaître que tu n’es pas là où tu veux être, c’est le point de départ pour changer ta vie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今いる場所が望む場所ではないと認めることが、人生を変える出発点になる。"
          }
        }
      }
    },
    "Rejection is not the end. Just a step on the right path." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zurückweisung ist nicht das Ende. Nur ein Schritt auf dem richtigen Weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El rechazo no es el final. Solo es un paso en el camino correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le rejet n’est pas la fin. Juste un pas sur le bon chemin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拒絶は終わりではない。正しい道の途中の一歩にすぎない。"
          }
        }
      }
    },
    "Replace fear of the unknown with curiosity." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ersetze die Angst vor dem Unbekannten durch Neugier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cambia el miedo a lo desconocido por curiosidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplace la peur de l’inconnu par la curiosité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "未知への恐れを、好奇心に置き換えよう。"
          }
        }
      }
    },
