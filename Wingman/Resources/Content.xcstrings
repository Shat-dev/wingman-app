          }
        }
      }
    },
    "Everything you’ve ever wanted is on the other side of fear." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles, was du dir je gewünscht hast, liegt auf der anderen Seite der Angst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
