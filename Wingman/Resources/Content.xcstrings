          }
        }
      }
    },
    "Believe that what you do makes a difference because it does." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glaub daran, dass dein Handeln etwas bewirkt – denn das tut es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cree que lo que haces marca la diferencia, porque la marca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crois que ce que tu fais compte, parce que c’est le cas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分の行動が変化を生むと信じよう。実際に、生むのだから。"
          }
        }
      }
    },
    "Believe you can and you're halfway there." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glaub, dass du es kannst, und du hast schon die Hälfte geschafft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cree que puedes y ya estás a mitad de camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Crois que tu peux, et tu as déjà fait la moitié du chemin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "できると信じれば、もう半分まで来ている。"
          }
        }
      }
    },
    "Better mindset & confidence" : {
      "comment" : "Onboarding answer option.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
