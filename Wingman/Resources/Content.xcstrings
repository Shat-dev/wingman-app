    "Not knowing what to say or how to start" : {
      "comment" : "Onboarding answer option.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nicht zu wissen, was ich sagen oder wie ich anfangen soll"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No saber qué decir ni cómo empezar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne pas savoir quoi dire ni comment commencer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "何を言えばいいか、どう始めればいいかわからない"
          }
        }
      }
    },
    "One bold move beats a lifetime of \"what ifs.\"" : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein mutiger Schritt schlägt ein Leben voller „Was wäre, wenn“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un paso valiente vale más que una vida de “¿y si…?”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un geste audacieux vaut mieux qu’une vie de « et si… »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一度の大胆な行動は、一生分の「もしも」に勝る。"
          }
        }
      }
    },
    "One can choose to go back toward safety or forward toward growth." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Man kann zurück in die Sicherheit gehen oder nach vorn ins Wachstum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uno puede elegir volver hacia la seguridad o avanzar hacia el crecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "On peut choisir de revenir vers la sécurité ou d’avancer vers la croissance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人は、安全へ引き返すことも、成長へ踏み出すことも選べる。"
          }
        }
      }
    },
    "Other" : {
      "comment" : "Onboarding answer option.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
