        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "活力と粘り強さは、すべてに打ち勝つ。"
          }
        }
      }
    },
    "Every \"no\" gets you one step closer to \"yes.\"" : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes „Nein“ bringt dich einen Schritt näher an ein „Ja“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
