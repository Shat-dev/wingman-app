    "Confidence isn’t something you’re born with. It’s something you build" : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Selbstvertrauen ist nicht angeboren. Du baust es dir auf"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La seguridad no es algo con lo que naces. Es algo que construyes."
          }
        }
      }
    },
    "Conversation Flow" : {
      "comment" : "Course category name: a Courses tab filter chip and section header, a Home carousel card, and the category part of the Home 'continue' card. Analytics keeps the English name.",
      "extractionState" : "manual",
      "localizations" : {
