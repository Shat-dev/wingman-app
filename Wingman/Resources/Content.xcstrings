            "state" : "needs_review",
            "value" : "Todo maestro fue alguna vez un principiante que se negó a rendirse."
          }
        }
      }
    },
    "Every successful person has faced rejection. The difference is they didn't let it stop them from trying again." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
