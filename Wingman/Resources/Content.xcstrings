    "Recognizing that you are not where you want to be is a starting point to begin changing your life." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zu erkennen, dass du noch nicht da bist, wo du sein willst, ist der Ausgangspunkt, um dein Leben zu verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reconocer que no estás donde quieres estar es el punto de partida para empezar a cambiar tu vida."
          }
        }
      }
    },
    "Rejection is not the end. Just a step on the right path." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zurückweisung ist nicht das Ende. Nur ein Schritt auf dem richtigen Weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El rechazo no es el final. Solo es un paso en el camino correcto."
          }
        }
      }
    },
    "Replace fear of the unknown with curiosity." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ersetze die Angst vor dem Unbekannten durch Neugier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cambia el miedo a lo desconocido por curiosidad."
          }
        }
