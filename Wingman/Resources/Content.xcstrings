    },
    "Small deeds done are better than great deeds planned." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kleine Taten, die man ausführt, sind besser als große, die man plant."
