    "All our dreams can come true, if we have the courage to pursue them." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle unsere Träume können wahr werden, wenn wir den Mut haben, ihnen zu folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos nuestros sueños pueden hacerse realidad si tenemos el valor de perseguirlos."
          }
        }
      }
    },
    "Any change, even a change for the better, is always accompanied by drawbacks and discomforts." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Veränderung, selbst eine zum Besseren, bringt Nachteile und Unbehagen mit sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todo cambio, incluso un cambio para bien, siempre trae inconvenientes e incomodidades."
          }
        }
      }
    },
    "Any problem is a chance for you to do your best." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes Problem ist eine Chance, dein Bestes zu geben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada problema es una oportunidad para dar lo mejor de ti."
          }
        }
      }
    },
    "Anything that happens beats nothing happening at all." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles, was passiert, ist besser, als wenn gar nichts passiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cualquier cosa que pase es mejor que no pase nada."
          }
        }
      }
    },
