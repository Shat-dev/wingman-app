    "Back on the market after a breakup or divorce" : {
      "comment" : "Onboarding answer option.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach einer Trennung oder Scheidung wieder Single"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otra vez soltero después de una ruptura o un divorcio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De nouveau célibataire après une rupture ou un divorce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "別れや離婚を経て、また出会いを探している"
          }
        }
      }
    },
    "Be not afraid of growing slowly; be afraid only of standing still." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fürchte nicht, langsam zu wachsen. Fürchte nur, stillzustehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No temas crecer lentamente; teme solo quedarte quieto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’aie pas peur d’avancer lentement, aie seulement peur de rester immobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ゆっくり進むことを恐れるな。恐れるべきは、立ち止まることだけだ。"
          }
        }
      }
    },
    "Beliefs & Reframes" : {
