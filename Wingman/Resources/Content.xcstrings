        }
      }
    },
    "One bold move beats a lifetime of \"what ifs.\"" : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein mutiger Schritt schlägt ein Leben voller „Was wäre, wenn“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un paso valiente vale más que una vida de “¿y si…?”."
          }
        }
      }
    },
    "One can choose to go back toward safety or forward toward growth." : {
      "comment" : "Daily quote on the Home screen.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
