    "Never approached before" : {
      "comment" : "Onboarding answer option.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Noch nie jemanden angesprochen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nunca lo he hecho"
